{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/s/:storeSlug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|meta-externalagent|meta-externalfetcher|WhatsApp|Twitterbot|LinkedInBot|Slackbot|Discordbot|TelegramBot|Pinterestbot|Applebot|Googlebot|GoogleOther|bingbot|Bingbot|DuckDuckBot|YandexBot).*"
        }
      ],
      "destination": "/api/storefront-preview?storeSlug=:storeSlug&routePath=/"
    },
    {
      "source": "/s/:storeSlug/p/:productSlug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|meta-externalagent|meta-externalfetcher|WhatsApp|Twitterbot|LinkedInBot|Slackbot|Discordbot|TelegramBot|Pinterestbot|Applebot|Googlebot|GoogleOther|bingbot|Bingbot|DuckDuckBot|YandexBot).*"
        }
