          "value": ".*(facebookexternalhit|Facebot|meta-externalagent|meta-externalfetcher|WhatsApp|Twitterbot|LinkedInBot|Slackbot|Discordbot|TelegramBot|Pinterestbot|Applebot|Googlebot|GoogleOther|bingbot|Bingbot|DuckDuckBot|YandexBot).*"
        }
      ],
      "destination": "/api/storefront-preview?routePath=/carta"
    },
    {
      "source": "/policies",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|meta-externalagent|meta-externalfetcher|WhatsApp|Twitterbot|LinkedInBot|Slackbot|Discordbot|TelegramBot|Pinterestbot|Applebot|Googlebot|GoogleOther|bingbot|Bingbot|DuckDuckBot|YandexBot).*"
        }
      ],
      "destination": "/api/storefront-preview?routePath=/policies"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|meta-externalagent|meta-externalfetcher|WhatsApp|Twitterbot|LinkedInBot|Slackbot|Discordbot|TelegramBot|Pinterestbot|Applebot|Googlebot|GoogleOther|bingbot|Bingbot|DuckDuckBot|YandexBot).*"
        }
      ],
      "destination": "/api/storefront-preview?routePath=/"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
