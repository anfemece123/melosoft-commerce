    },
    {
      "source": "/s/:storeSlug/catalog",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|meta-externalagent|meta-externalfetcher|WhatsApp|Twitterbot|LinkedInBot|Slackbot|Discordbot|TelegramBot|Pinterestbot|Applebot|Googlebot|GoogleOther|bingbot|Bingbot|DuckDuckBot|YandexBot).*"
        }
      ],
      "destination": "/api/storefront-preview?storeSlug=:storeSlug&routePath=/catalog"
    },
    {
      "source": "/s/:storeSlug/carta",
      "has": [
        {
          "type": "header",
